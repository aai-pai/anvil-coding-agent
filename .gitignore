# Local scratch and external clones
/temp/

# Generated Anvil run workspaces (each run is self-contained & disposable)
/runs/*
!/runs/README.md
/workspace/runs/

# Runtime-generated state and audit logs (per-run copies live under runs/)
/logs/
/.anvil/
*.json.corrupt
*.json.tmp

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
build/
dist/

# Node / TypeScript
node_modules/
extension/dist/
*.tsbuildinfo

# Built extension packages (rebuild with `vsce package`; do not commit)
*.vsix

# PPT
*.pptx
# ...except the versioned overview decks, which are deliberate deliverables
# and were already tracked despite the rule above.
!Anvil_Eval_Harness.pptx
!Anvil_v0.1.2.pptx
!anvil-development/*/Anvil_*.pptx

# Claude Code local settings (may contain API keys)
.claude/settings.local.json